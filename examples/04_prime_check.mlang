// Example 4: Prime Number Checker
// Demonstrates boolean logic, early returns, modulo operator, and loop conditions.

fn is_prime(n: int) -> bool {
    if (n <= 1) {
        return false;
    }
    if (n <= 3) {
        return true;
    }
    if (n % 2 == 0 || n % 3 == 0) {
        return false;
    }
    
    let d = 5;
    while (d * d <= n) {
        if (n % d == 0 || n % (d + 2) == 0) {
            return false;
        }
        d = d + 6;
    }
    return true;
}

print("Testing prime checker for numbers from 1 to 25:");
let candidate = 1;
let prime_count = 0;
while (candidate <= 25) {
    let prime = is_prime(candidate);
    if (prime) {
        print(candidate, "is PRIME");
        prime_count = prime_count + 1;
    } else {
        print(candidate, "is composite / not prime");
    }
    candidate = candidate + 1;
}

print("Total primes found up to 25:", prime_count);
